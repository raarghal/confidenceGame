# Copy to .env and fill in. Only needed to query a model (scripts/run_experiment.py);
# reproducing the paper (scripts/section5.py, scripts/section6.py) needs no key.
#
# The paper's runs used gpt-oss-120b through Together: https://api.together.ai/settings/api-keys
TOGETHERAI_API_KEY=

# Models are called through LiteLLM, so a config can name any provider's model instead.
# Set that provider's key here, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
